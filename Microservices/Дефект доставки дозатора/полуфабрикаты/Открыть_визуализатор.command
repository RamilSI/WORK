#!/bin/bash
# Открывает визуализатор дефекта через локальный сервер.
# Сервер поднимается из корня папки, потому что визуализатор лежит в «полуфабрикаты»,
# а фото — в корне. Локальный сервер нужен ещё и для сохранения PNG-аннотации
# (на file:// браузер блокирует экспорт canvas).
cd "$(dirname "$0")/.." || exit 1
PORT=8765
echo "Запускаю локальный сервер на http://localhost:$PORT ..."
python3 -m http.server "$PORT" >/dev/null 2>&1 &
SRV=$!
trap 'kill $SRV 2>/dev/null' EXIT
sleep 1
open "http://localhost:$PORT/полуфабрикаты/визуализатор_дефекта.html"
echo "Визуализатор открыт в браузере. Не закрывайте это окно терминала."
echo "Для остановки нажмите Ctrl+C."
wait $SRV
